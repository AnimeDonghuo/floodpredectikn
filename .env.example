# Server Port Configuration
PORT=8080

# MongoDB Connection String (Atlas Free Tier recommended)
# Leave blank to run the application in robust in-memory mode!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jio_shield?retryWrites=true&w=majority

# Base URL for API requests (calculated automatically in frontend, but configurable)
API_BASE_URL=http://localhost:8080
