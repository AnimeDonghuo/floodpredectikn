# Demo is safe by default. Set LIVE_SMS=true only when you intentionally want real Twilio messages.
DEMO_MODE=true
LIVE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional single destination, matching the Twilio Python quickstart pattern
TWILIO_TO=
# Or use multiple comma-separated E.164 numbers
SMS_RECIPIENTS=
